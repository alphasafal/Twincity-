# TwinPilot environment variables (development / demo)
# Copy to .env at the repo root (and optionally apps/web/.env.local).
# DEMO credentials are for local demos only — never use in production.

# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
DEMO_MODE=true
API_HOST=0.0.0.0
API_PORT=8000

# SQLite by default (no Redis/Postgres required for demo profile)
DATABASE_URL=sqlite:///./twinpilot.db

# ── Auth / JWT ───────────────────────────────────────────────────────
JWT_SECRET=twinpilot-dev-access-secret-change-me
JWT_REFRESH_SECRET=twinpilot-dev-refresh-secret-change-me
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS / web origin ────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Telemetry ingest (optional; skipped validation when DEMO_MODE=true)
TELEMETRY_INGEST_TOKEN=demo-telemetry-token

# ── Control loop ─────────────────────────────────────────────────────
CONTROL_LOOP_ENABLED=true
CONTROL_INTERVAL_SECONDS=5
DEFAULT_BUILDING_TIMEZONE=Asia/Kolkata

# ── Simulator ────────────────────────────────────────────────────────
# mock (default) | energyplus
SIMULATOR_PROVIDER=mock

# EnergyPlus (optional). When unset/unavailable, adapter falls back to mock.
ENERGYPLUS_HOME=
ENERGYPLUS_MODEL_PATH=
ENERGYPLUS_WEATHER_PATH=

# ── Agent / assistant ────────────────────────────────────────────────
# deterministic (default, no LLM) | ollama
AGENT_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Rate limits ──────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_ASSISTANT_PER_MINUTE=20

# ── Frontend (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Mobile (apps/mobile) ─────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── MCP server (services/mcp-server) ─────────────────────────────────
TWINPILOT_API_URL=http://localhost:8000
TWINPILOT_API_EMAIL=manager@twinpilot.demo
TWINPILOT_API_PASSWORD=TwinPilot-Manager-Demo!
TWINPILOT_API_TOKEN=
TWINPILOT_BUILDING_ID=
TWINPILOT_MCP_TRANSPORT=stdio
TWINPILOT_MCP_FORCE_FALLBACK=0
