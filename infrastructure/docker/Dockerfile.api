# TwinPilot API (FastAPI) — demo / local container image
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATABASE_URL=sqlite:////data/twinpilot.db

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data

# Install local Python packages first so editable path deps resolve
COPY services/optimizer /app/services/optimizer
COPY services/simulator /app/services/simulator
COPY services/agent /app/services/agent
COPY services/api /app/services/api

RUN pip install --upgrade pip \
 && pip install -e /app/services/optimizer \
 && pip install -e /app/services/simulator \
 && pip install -e /app/services/agent \
 && pip install -e "/app/services/api[dev]" \
 || pip install -r /app/services/api/requirements.txt \
    && pip install -e /app/services/optimizer \
    && pip install -e /app/services/simulator \
    && pip install -e /app/services/agent \
    && pip install -e /app/services/api

WORKDIR /app/services/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
